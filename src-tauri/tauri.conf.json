{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diskclarity",
  "version": "3.3.0",
  "identifier": "tech.ezeny.diskclarity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskClarity",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "additionalBrowserArgs": "--js-flags=--expose-gc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Disk space analysis tool",
    "longDescription": "An efficient and lightweight disk space analysis tool."
  }
}
